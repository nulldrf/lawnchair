<?xml version="1.0" encoding="utf-8"?>
<!--
    Dummy ENTER animation for the app window.

    Keeps the app fully invisible (alpha 0→1 with a long startOffset) during
    the launcher exit animation so the launcher's dragLayer animation plays
    unobstructed. The app appears after the launcher animation completes.

    Used by PIE, SLIDE_UP, BLINK, and FADE modes.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0.0"
    android:toAlpha="1.0"
    android:duration="100"
    android:startOffset="400" />
