<?xml version="1.0" encoding="utf-8"?>
<!--
    Dummy EXIT animation for the launcher window.

    Keeps the launcher window fully opaque (alpha 1→1) during the entire
    transition so the LAYER_TYPE_HARDWARE dragLayer animation is composited
    on top of it. If this faded or moved the launcher window, it would fight
    the dragLayer animator.

    Used by PIE, SLIDE_UP, BLINK, and FADE modes.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="1.0"
    android:toAlpha="1.0"
    android:duration="500" />
