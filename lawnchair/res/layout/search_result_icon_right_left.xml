<?xml version="1.0" encoding="utf-8"?>
<app.lawnchair.allapps.views.SearchResultRightLeftIcon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_result_icon_row_left_right"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_result_files_row_height"
    android:orientation="horizontal"
    android:paddingStart="8dp">

    <!--
        files_preview: width, height, and marginStart are set programmatically in
        onFinishInflate to match SearchResultIcon's own sizing so photo thumbnails
        and vector file icons have identical visual footprint. XML dimensions are
        left as wrap_content as a safe fallback only.
    -->
    <app.lawnchair.util.ImageViewWrapper
        android:id="@+id/files_preview"
        style="@style/BaseIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:drawableTint="?android:textColorPrimary"
        launcher:iconDisplay="search_result_small"
        launcher:layoutHorizontal="true"
        launcher:matchTextInsetWithQuery="true" />

    <app.lawnchair.allapps.views.SearchResultIcon
        android:id="@+id/avatar"
        style="@style/BaseIcon"
        android:layout_width="@dimen/search_row_icon_size"
        android:layout_height="wrap_content"
        android:drawableTint="?android:textColorPrimary"
        launcher:iconDisplay="search_result_tall"
        launcher:layoutHorizontal="true" />

    <!--
        text_rows: orientation and singleLine behaviour are now controlled entirely
        in SearchResultRightLeftIcon.kt depending on whether this row is a file
        (vertical, 2-line) or a contact (horizontal, 1-line). The XML sets the
        neutral defaults; the view overrides them on bind.
    -->
    <LinearLayout
        android:id="@+id/text_rows"
        style="@style/AllAppsSearchResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1.0"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dynamic_grid_edge_margin"
        android:paddingTop="@dimen/dynamic_grid_edge_margin"
        android:paddingEnd="@dimen/dynamic_grid_edge_margin"
        android:paddingBottom="@dimen/dynamic_grid_edge_margin">

        <TextView
            android:id="@+id/title"
            style="@style/AllAppsSearchResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|center"
            android:maxLines="2"
            android:paddingEnd="4dp"
            android:textAlignment="viewStart"
            android:textColor="?android:textColorPrimary"
            android:textSize="@dimen/search_result_hero_title_size" />

        <TextView
            android:id="@+id/delimiter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start|center"
            android:maxLines="1"
            android:text="•"
            android:textColor="?android:textColorPrimary"
            android:textSize="@dimen/search_result_hero_subtitle_size"
            android:visibility="gone" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:singleLine="true"
            android:textColor="?android:textColorSecondary"
            android:textSize="@dimen/search_result_hero_subtitle_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:paddingTop="@dimen/dynamic_grid_edge_margin"
        android:paddingEnd="@dimen/dynamic_grid_edge_margin"
        android:paddingBottom="@dimen/dynamic_grid_edge_margin">

        <ImageView
            android:id="@+id/icon1"
            style="@style/BaseIcon"
            android:layout_width="@dimen/search_row_medium_icon_size"
            android:layout_height="@dimen/search_row_medium_icon_size"
            android:background="@drawable/pill_ripple"
            android:clickable="true"
            android:contentDescription="@string/custom"
            android:drawableTint="?android:textColorPrimary"
            android:ellipsize="end"
            launcher:iconDisplay="search_result_small"
            launcher:layoutHorizontal="true"
            launcher:matchTextInsetWithQuery="true" />

        <ImageView
            android:id="@+id/icon2"
            style="@style/BaseIcon"
            android:layout_width="@dimen/search_row_medium_icon_size"
            android:layout_height="@dimen/search_row_medium_icon_size"
            android:layout_marginLeft="@dimen/search_result_padding_medium"
            android:background="@drawable/pill_ripple"
            android:clickable="true"
            android:contentDescription="@string/custom"
            android:drawableTint="?android:textColorPrimary"
            android:ellipsize="end"
            launcher:iconDisplay="search_result_small"
            launcher:layoutHorizontal="true"
            launcher:matchTextInsetWithQuery="true" />

    </LinearLayout>
</app.lawnchair.allapps.views.SearchResultRightLeftIcon>
