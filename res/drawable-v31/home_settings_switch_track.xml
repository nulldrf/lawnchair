<?xml version="1.0" encoding="utf-8"?>
<!--
  MD3-style track.
  Uses a selector so the OFF state has a visible outline (like MD3)
  and the ON state is filled. Color tokens come from the existing
  home_settings_switch_track_color.xml selector via android:tint
  set in SwitchStyle.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape
            android:shape="rectangle"
            android:width="52dp"
            android:height="28dp">
            <solid android:color="@color/home_settings_track_off_color" />
            <corners android:radius="35dp" />
        </shape>
    </item>

    <!-- OFF: outlined track (MD3 style) -->
    <item android:state_checked="false">
        <shape
            android:shape="rectangle"
            android:width="52dp"
            android:height="28dp">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/home_settings_track_off_color" />
            <corners android:radius="35dp" />
        </shape>
    </item>

    <!-- ON: filled track -->
    <item>
        <shape
            android:shape="rectangle"
            android:width="52dp"
            android:height="28dp">
            <solid android:color="@color/home_settings_track_on_color" />
            <corners android:radius="35dp" />
        </shape>
    </item>

</selector>
